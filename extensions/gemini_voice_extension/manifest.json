{
  "manifest_version": 3,
  "name": "Gemini Live Voice & Antigravity Bridge",
  "version": "1.1.0",
  "description": "Real-time full-duplex voice conversations, speech dictation, and animated Gemini orb for Gemini Web, AI Studio, and Antigravity.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel", "contextMenus", "alarms"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://antigravity.google.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Gemini Live Voice Hub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://antigravity.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
