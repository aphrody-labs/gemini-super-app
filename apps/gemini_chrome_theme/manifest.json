{
  "manifest_version": 3,
  "name": "Gemini Dark Theme",
  "short_name": "GeminiDark",
  "version": "1.2.0",
  "description": "Minimalist Google Gemini Material 3 Dark theme (#131314 / #1e1f20 / #a8c7fa).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "theme": {
    "colors": {
      "frame": [19, 19, 20],
      "frame_inactive": [24, 25, 27],
      "frame_incognito": [14, 14, 16],
      "frame_incognito_inactive": [20, 20, 22],
      "toolbar": [30, 31, 32],
      "toolbar_text": [227, 227, 227],
      "toolbar_button_icon": [168, 199, 250],
      "tab_text": [227, 227, 227],
      "tab_background_text": [196, 199, 197],
      "tab_background_text_inactive": [142, 145, 143],
      "bookmark_text": [227, 227, 227],
      "ntp_background": [19, 19, 20],
      "ntp_text": [227, 227, 227],
      "ntp_link": [168, 199, 250],
      "ntp_header": [30, 31, 32],
      "omnibox_background": [40, 42, 44],
      "omnibox_text": [227, 227, 227],
      "button_background": [40, 42, 44]
    },
    "tints": {
      "buttons": [0.6, 0.85, 0.82],
      "frame": [-1, -1, -1],
      "frame_inactive": [-1, -1, 0.4],
      "frame_incognito": [-1, 0.2, 0.15],
      "frame_incognito_inactive": [-1, 0.2, 0.25],
      "background_tab": [-1, 0.4, 0.22]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat"
    }
  }
}
