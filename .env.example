# 1. Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=aphrody
GOOGLE_CLOUD_PROJECT_NUMBER=468000409790
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_QUOTA_PROJECT=aphrody

# 2. Aphrody Service Accounts (Impersonated via ADC / gcloud — no static keys)
APHRODY_SERVICE_ACCOUNT=aphrody-bot@aphrody.iam.gserviceaccount.com
APHRODY_AUTOMATION_SERVICE_ACCOUNT=bun-google-automation@aphrody.iam.gserviceaccount.com
APHRODY_FIREBASE_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@aphrody.iam.gserviceaccount.com

# 3. Aphrody OAuth 2.0 Clients (Synced from Secret Manager)
GOOGLE_CLIENT_ID=468000409790-f66ui5vphebsj9mgu38b146s519pu11d.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
AUTO_GOOGLE_CLIENT_ID=468000409790-qf5cjq6vdj2v0rsdgnj5deb5kt6l9k9t.apps.googleusercontent.com
AUTO_GOOGLE_CLIENT_SECRET=your-auto-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback

# 4. Google AI, Gemini & YouTube Data v3 API Keys (Synced from API Keys service)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-aphrody-full-api-key
YOUTUBE_API_KEY=your-achillea-youtube-api-key

# Jeton autorisé par le serveur compagnon de YouTube Music Desktop (facultatif)
YTM_COMPANION_TOKEN=

# Chemin optionnel vers voice-dsp ; sinon recherche dans dist/bin puis PATH
VOICE_DSP_BIN=
# Facultatif : racine contenant les ressources de l'application
SUPER_APP_ROOT=

# 5. Best-in-Class Google AI Models (2026 Canonical Lineup)
# Reasoning & General Multimodal
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
# Speech-to-Speech (STS) & Live Voice
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_THINKING_MODEL=gemini-3.8-live-extended-thinking
GEMINI_LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
# Text-to-Speech (TTS), Voice Design & Replication
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_LITE_MODEL=gemini-3.8-flash-lite-tts
GEMINI_DEFAULT_VOICE=Aoede
# Speech-to-Text (STT)
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_STT_LIVE_MODEL=gemini-3.5-transcribe-live
WHISPER_LOCAL_MODEL=large-v3-turbo
# Lyria Music Generation
GEMINI_LYRIA_SONG_MODEL=lyria-3.5
GEMINI_LYRIA_CLIP_MODEL=lyria-3-clip-preview
GEMINI_LYRIA_REALTIME_MODEL=models/lyria-realtime-exp
# Flow / Video Generation & Editing
GEMINI_FLOW_VIDEO_MODEL=gemini-omni-1.1-flash
# Image Generation & Multimodal Embeddings
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Managed Agents & Deep Research
GEMINI_MANAGED_AGENT=antigravity-preview-09-2026
GEMINI_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
GEMINI_DEEP_RESEARCH_MAX_AGENT=deep-research-max-preview-04-2026

# Origines navigateur explicitement autorisées à accéder à l'API locale, séparées par des virgules.
# Exemple : SUPER_APP_ALLOWED_ORIGINS=https://gemini.google.com
SUPER_APP_ALLOWED_ORIGINS=
