{
  "name": "gemini-live-voice-monorepo",
  "version": "2026.11.0",
  "private": true,
  "type": "module",
  "description": "Unified November 2026 Monorepo (Rust Crates + Bun v1.4.5 Packages + Python uv + Tauri v3 Alpha) for the One Big Gemini Voice, Audio & Music Super App",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "consolidate": "bun run scripts/consolidate_monorepo.ts",
    "build": "bun build apps/gemini_super_app/src/server.ts --outdir ./dist --target bun",
    "build:dsp": "bun run scripts/build_voice_dsp.ts",
    "build:aot": "bun build --compile --bytecode --minify apps/gemini_super_app/src/server.ts --outfile dist/bin/gemini-super-app.exe && bun build --compile --bytecode --minify scripts/gemini_24_7_supervisor.ts --outfile dist/bin/gemini-supervisor-24x7.exe && bun build --compile --bytecode --minify packages/gemini_app_plugin/mcp_server.ts --outfile dist/bin/gemini-app-runtime-mcp.exe",
    "build:rust:lto": "cargo build --release -p gemini-super-tauri --bin gemini-windows-tauri-v3",
    "build:uv:bin": "uv sync",
    "wallpaper:apply": "dist/bin/gemini-windows-tauri-v3.exe --apply-wallpaper",
    "super-app": "bun run apps/gemini_super_app/src/server.ts",
    "super-app:dev": "bun --watch run apps/gemini_super_app/src/server.ts",
    "check": "bun check",
    "fmt": "bun fmt packages scripts apps/gemini_super_app apps/gemini_windows_patcher/src",
    "fmt:check": "bun fmt --check packages scripts apps/gemini_super_app apps/gemini_windows_patcher/src",
    "lint": "bun lint packages scripts apps/gemini_super_app apps/gemini_windows_patcher/src",
    "test": "bun test",
    "test:rust": "cargo test --workspace",
    "test:python": "uv run pytest",
    "patch:gemini": "bun run apps/gemini_windows_patcher/src/patch_gemini_desktop.ts",
    "assistant:supervisor": "bun run scripts/gemini_24_7_supervisor.ts",
    "assistant:check": "bun run scripts/gemini_24_7_supervisor.ts --once",
    "assistant:status": "bun run scripts/setup_windows_persistent_service.ts --status",
    "chrome:gemini": "bun run scripts/setup_chrome_gemini_ai.ts",
    "package:cws": "bun run scripts/package_chrome_web_store.ts",
    "voice:server": "uv run python backend/voice_bridge_server.py",
    "voice:hub": "uv run python backend/super_app_hub.py",
    "cookies:import": "bun run scripts/gemini_cookie_daemon.ts import",
    "cookies:refresh": "bun run scripts/gemini_cookie_daemon.ts refresh",
    "cookies:status": "bun run scripts/gemini_cookie_daemon.ts status",
    "cookies:daemon": "bun run scripts/gemini_cookie_daemon.ts daemon",
    "windows:migrate": "bun run scripts/gemini_windows_tauri_v3.ts",
    "windows:tauri-v3": "cargo run -p gemini-super-tauri --bin gemini-windows-tauri-v3"
  },
  "dependencies": {
    "@gemini-live/google-ai-suite": "workspace:*",
    "@gemini-live/openpets-gemini": "workspace:*",
    "@google/genai": "^2.32.0",
    "@tauri-apps/api": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-dialog": "^3.0.0-alpha.4",
    "@tauri-apps/plugin-fs": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-shell": "^3.0.0-alpha.3",
    "@tauri-apps/plugin-store": "^3.0.0-alpha.3",
    "google-auth-library": "^11.3.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "wavesurfer.js": "^8.0.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^3.0.0-alpha.5",
    "@types/bun": "^1.4.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
